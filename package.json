{
  "name": "freedom-at-50",
  "version": "1.0.0",
  "private": true,
  "description": "Freedom personal finance progress app — static PWA with optional Capacitor iOS shell",
  "type": "module",
  "scripts": {
    "cap:prepare": "node scripts/prepare-capacitor-web.mjs",
    "cap:sync": "npm run cap:prepare && npx cap sync ios",
    "cap:open": "npx cap open ios",
    "test:capacitor-web": "node scripts/test-capacitor-web-prepare.mjs",
    "test:native-storage": "node scripts/test-native-storage-mirror.mjs",
    "test:native-notifications": "node scripts/test-native-notifications.mjs",
    "test:splash-layout": "node scripts/test-splash-layout-stability.mjs",
    "test:native-backup": "node scripts/test-native-backup-export.mjs",
    "test:native-purchases": "node scripts/test-native-purchases.mjs",
    "test:subscription-gate": "node scripts/test-subscription-gate.mjs",
    "test:privacy-prerelease": "node scripts/test-privacy-prerelease.mjs",
    "test:legal-support-links": "node scripts/test-legal-support-links.mjs"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@revenuecat/purchases-capacitor": "^14.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "puppeteer-core": "^24.2.0"
  }
}
